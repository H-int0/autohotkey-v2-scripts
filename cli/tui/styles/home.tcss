/* =============================================================================
   home.tcss
   ============================================================================= */

HomeScreen {
    background: #0d0d0f;
}

#left-panel {
    width: 30%;
    border-right: tall #1e2030;
    height: 100%;
    /* No bottom padding — footer docks inside and padding would clip it */
    padding: 1 2 0 2;
    background: #111116;
}

#right-panel {
    width: 70%;
    height: 100%;
    background: #0d0d0f;
}

.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid $primary 30%;
}

#status-text {
    height: auto;
    margin-bottom: 1;
    color: #c8ccd8;
}

#commands-text {
    height: auto;
    margin-bottom: 1;
    color: #565970;
}

#home-left-content {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    /* Bottom padding here so scrollable content clears the footer */
    padding-bottom: 1;
}

#hints-text {
    height: auto;
    color: #5c7fbf 90%;
}

#footer-text {
    dock: bottom;
    color: #3a3d4f;
    height: 3;
    content-align: left bottom;
    border-top: solid #1e2030;
    background: #0e0e13;
    padding: 0 1;
}

/* ---------------------------------------------------------------------------
   Right panel — log + prompt
   --------------------------------------------------------------------------- */

RichLog {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    background: transparent;
    border: none;
    color: #c8ccd8;
}

#prompt-row {
    dock: bottom;
    border-top: tall #1e2030;
    height: 3;
    align: left middle;
    background: #111116;
    padding: 0 2;
}

#prompt-prefix {
    width: auto;
    padding: 0 1;
    color: #5c7fbf;
    text-style: bold;
}

#prompt {
    width: 1fr;
    border: none;
    background: transparent;
    color: #c8ccd8;
}
