#left-panel {
    width: 30%;
    border-right: solid $primary;
    height: 100%;
    padding: 1 2;
}

#right-panel {
    width: 70%;
    height: 100%;
}

.panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#status-text {
    height: auto;
    margin-bottom: 2;
}

#commands-text {
    height: auto;
    margin-bottom: 1;
}

#home-left-content {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden; /* Forces text to adjust/wrap when terminal resizes */
}

#hints-text {
    height: auto;
}

#footer-text {
    dock: bottom; /* Pins it to the bottom */
    color: $text-muted;
    height: 2;
    content-align: left bottom;
}

RichLog {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: transparent;
    border: none;
}

#prompt-row {
    dock: bottom;
    border-top: solid $primary;
    height: 3;
    align: left middle;
}

#prompt-prefix {
    width: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#prompt {
    width: 1fr;
    border: none;
    background: transparent;
}
