/* =============================================================================
   config.tcss
   Styles for ConfigScreen, ConfigPanel, and all config popups.
   ============================================================================= */

ConfigScreen {
    background: #0d0d0f;
}

ConfigScreen #left-panel {
    width: 30%;
    border-right: tall #1e2030;
    height: 100%;
    /* No bottom padding — footer docks inside and padding would clip it */
    padding: 1 2 0 2;
    background: #111116;
}

ConfigScreen #right-panel {
    width: 70%;
    height: 100%;
    background: #0d0d0f;
}

#config-status-text {
    height: auto;
    margin-bottom: 1;
    color: #c8ccd8;
}

#config-commands-text {
    height: auto;
    margin-bottom: 1;
    color: #565970;
}

#config-left-content {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    /* Bottom padding so scrollable content clears the footer */
    padding-bottom: 1;
}

#config-hints-text {
    height: auto;
    color: #5c7fbf 90%;
}

#config-footer-text {
    dock: bottom;
    color: #3a3d4f;
    height: 3;
    content-align: left bottom;
    border-top: solid #1e2030;
    background: #0e0e13;
    padding: 0 1;
}

/* ---------------------------------------------------------------------------
   Config panel (right side — the settings list)
   --------------------------------------------------------------------------- */

#config-title {
    text-style: bold;
    color: #5c7fbf;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid #1e2030;
}

#config-panel-container {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1 2;
}

#config-panel {
    height: auto;
    color: #c8ccd8;
}

#config-prompt-row {
    dock: bottom;
    border-top: tall #1e2030;
    height: 3;
    align: left middle;
    background: #111116;
    padding: 0 2;
}

#config-prompt-prefix {
    width: auto;
    padding: 0 1;
    color: #5c7fbf;
    text-style: bold;
}

#config-prompt {
    width: 1fr;
    border: none;
    background: transparent;
    color: #c8ccd8;
}

/* ---------------------------------------------------------------------------
   Popup styling
   --------------------------------------------------------------------------- */

_BasePopup {
    align: right top;
    background: transparent;
}

.popup-right-panel {
    width: 70%;
    height: 100%;
}

.config-popup {
    height: 1fr;
    background: #0f0f14;
    border-left: tall #1e2030;
    padding: 0 2;
}

.popup-prompt-row {
    dock: bottom;
    border-top: tall #1e2030;
    height: 3;
    align: left middle;
    background: #111116;
    padding: 0 2;
}

.popup-prompt-prefix {
    width: auto;
    padding: 0 1;
    color: #5c7fbf;
    text-style: bold;
}

.popup-prompt-row Input {
    width: 1fr;
    border: none;
    background: transparent;
    color: #c8ccd8;
}

.popup-title {
    text-style: bold;
    color: #5c7fbf;
    margin-bottom: 1;
    padding-bottom: 1;
    border-bottom: solid #1e2030;
}

.popup-divider {
    color: #2a2d3e;
    margin-bottom: 1;
}

.popup-scroll {
    height: 1fr;
    overflow-y: auto;
}

.popup-help {
    border-top: solid #1e2030;
    padding-top: 1;
    margin-top: 1;
    height: auto;
    color: #565970;
}

/* ---------------------------------------------------------------------------
   Timezone popup extras
   --------------------------------------------------------------------------- */

#tz-saved-section {
    height: auto;
    margin-bottom: 1;
    border-bottom: dashed #2a2d3e;
    padding-bottom: 1;
}

#tz-saved-title {
    text-style: bold;
    color: #5c7fbf;
    margin-bottom: 1;
}

#tz-search-row {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#tz-search-input {
    width: 1fr;
    border: tall #2a2d3e;
    background: #111116;
    color: #c8ccd8;
}

#tz-filter-btn {
    width: auto;
    margin-left: 1;
}

#tz-filter-tags {
    width: auto;
    height: auto;
    margin-bottom: 1;
    color: #5c7fbf 70%;
}

#tz-filter-dropdown {
    background: #111116;
    border: tall #2a2d3e;
    width: 20;
    height: auto;
    max-height: 12;
    overflow-y: auto;
    display: none;
}

#tz-list {
    height: 1fr;
    overflow-y: auto;
}

/* ---------------------------------------------------------------------------
   Boolean popup option rows
   --------------------------------------------------------------------------- */

.option-row {
    height: 1;
    padding: 0 1;
    color: #c8ccd8;
}

.option-row:hover {
    background: #1e2030;
    color: #e8eaf2;
}

.option-row.--selected {
    color: #5c7fbf;
    text-style: bold;
}
