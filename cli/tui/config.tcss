/* =============================================================================
   config.tcss
   Styles for ConfigScreen, ConfigPanel, and all config popups.
   ============================================================================= */

/* ---------------------------------------------------------------------------
   Config screen layout mirrors home.tcss panels
   --------------------------------------------------------------------------- */

ConfigScreen #left-panel {
    width: 30%;
    border-right: solid $primary;
    height: 100%;
    padding: 1 2;
}

ConfigScreen #right-panel {
    width: 70%;
    height: 100%;
    padding: 1 2;
}

#config-status-text {
    height: auto;
    margin-bottom: 1;
}

#config-commands-text {
    height: auto;
    margin-bottom: 1;
}

#config-left-content {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden; /* Forces text to adjust/wrap when terminal resizes */
}

#config-hints-text {
    height: auto;
}

#config-footer-text {
    dock: bottom; /* Pins it to the bottom */
    color: $text-muted;
    height: 2;
    content-align: left bottom;
}

/* ---------------------------------------------------------------------------
   Config panel (right side the settings list)
   --------------------------------------------------------------------------- */

#config-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#config-panel-container {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
}

#config-panel {
    height: auto;
}

#config-prompt-row {
    dock: bottom;
    border-top: solid $primary;
    height: 3;
    align: left middle;
}

#config-prompt-prefix {
    width: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

#config-prompt {
    width: 1fr;
    border: none;
    background: transparent;
}

/* ---------------------------------------------------------------------------
   Popup styling so it replaces ONLY the right side
   --------------------------------------------------------------------------- */

_BasePopup {
    align: right top;
    background: transparent;
}

.popup-right-panel {
    width: 70%;
    height: 100%;
}

.config-popup {
    height: 1fr;
    background: $surface;
    padding: 1 2;
}

.popup-prompt-row {
    dock: bottom;
    border-top: solid $primary;
    height: 3;
    align: left middle;
    background: $surface;
}

.popup-prompt-prefix {
    width: auto;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.popup-prompt-row Input {
    width: 1fr;
    border: none;
    background: transparent;
}

.popup-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.popup-divider {
    color: $text-muted;
    margin-bottom: 1;
}

/* Scrollable content area inside popups */
.popup-scroll {
    height: 1fr;
    overflow-y: auto;
}

/* Pinned help section always at bottom, never scrolls */
.popup-help {
    border-top: solid $primary;
    padding-top: 1;
    margin-top: 1;
    height: auto;
    color: $text-muted;
}

/* ---------------------------------------------------------------------------
   Timezone popup extras
   --------------------------------------------------------------------------- */

#tz-saved-section {
    height: auto;
    margin-bottom: 1;
    border-bottom: dashed $primary;
    padding-bottom: 1;
}

#tz-saved-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

#tz-search-row {
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

#tz-search-input {
    width: 1fr;
    border: solid $primary;
    background: transparent;
}

#tz-filter-btn {
    width: auto;
    margin-left: 1;
}

#tz-filter-tags {
    width: auto;
    height: auto;
    margin-bottom: 1;
}

#tz-filter-dropdown {
    background: $surface;
    border: solid $primary;
    width: 20;
    height: auto;
    max-height: 12;
    overflow-y: auto;
    display: none;  /* shown programmatically */
}

#tz-list {
    height: 1fr;
    overflow-y: auto;
}

/* ---------------------------------------------------------------------------
   Boolean popup option rows highlight on hover/focus
   --------------------------------------------------------------------------- */

.option-row {
    height: 1;
    padding: 0 1;
}

.option-row:hover {
    background: $primary 20%;
}

.option-row.--selected {
    color: $accent;
    text-style: bold;
}
